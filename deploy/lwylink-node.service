[Unit]
Description=LwyLink room node
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/lwylink
ExecStart=/opt/lwylink/lwylink-node -config /opt/lwylink/configs/node.prod.json
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
