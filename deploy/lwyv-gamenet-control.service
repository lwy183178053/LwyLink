[Unit]
Description=LwyV GameNet control plane
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/lwyv-gamenet
ExecStart=/opt/lwyv-gamenet/gamenet-control -config /opt/lwyv-gamenet/configs/control.prod.json
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
